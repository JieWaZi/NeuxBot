{
  "name": "@neuxbot/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json",
    "lint": "eslint .",
    "ui:check": "node ../scripts/check-ui-style-policy.mjs",
    "format": "prettier --write . ../package.json ../pnpm-workspace.yaml ../scripts/*.mjs ../scripts/*.cjs",
    "format:check": "prettier --check . ../package.json ../pnpm-workspace.yaml ../scripts/*.mjs ../scripts/*.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm ui:check && pnpm format:check && pnpm test && pnpm build && pnpm bundle:check && pnpm electron:build && pnpm electron:test",
    "bundle:check": "node ../scripts/check-desktop-entry-budget.mjs",
    "api:generate": "pnpm --dir ../packages/frontend api:generate",
    "electron:build": "node ../scripts/build-electron.mjs",
    "electron:dev": "node ../scripts/dev-electron.mjs",
    "electron:test": "node --test electron/tests/*.test.mjs",
    "electron:package": "node ../scripts/package-desktop.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@git-diff-view/file": "0.1.7",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "i18next": "26.3.6",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "zod": "4.4.3",
    "@neuxbot/frontend": "workspace:*",
    "@neuxbot/platform-contracts": "workspace:*",
    "node-pty": "1.1.0",
    "@neuxbot/terminal-runtime": "workspace:*"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.neuxally.desktop",
    "productName": "NeuxBot",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "dist-native",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../resources/pi-bridge",
        "to": "pi-bridge",
        "filter": [
          "bridge.mjs",
          "MCP-LICENSES.txt"
        ]
      },
      {
        "from": "resources/plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "binaries",
        "to": "bin",
        "filter": [
          "ally-core",
          "ally-core.exe",
          "allycli",
          "allycli.exe"
        ]
      },
      {
        "from": "resources/tray/allyTemplate.png",
        "to": "tray/allyTemplate.png"
      },
      {
        "from": "resources/tray/allyTemplate@2x.png",
        "to": "tray/allyTemplate@2x.png"
      },
      {
        "from": "resources/tray/ally.ico",
        "to": "tray/ally.ico"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/licenses/neux-knowledge",
        "to": "licenses/neux-knowledge",
        "filter": [
          "LICENSE",
          "THIRD_PARTY_NOTICES.md"
        ]
      },
      {
        "from": "../resources/terminal-runtime/worker.cjs",
        "to": "terminal-runtime/worker.cjs"
      },
      {
        "from": "../resources/terminal-runtime/node_modules/node-pty",
        "to": "terminal-runtime/node_modules/node-pty",
        "filter": [
          "package.json",
          "lib/**/*",
          "LICENSE",
          "prebuilds/${platform}-${arch}/**/*",
          "build/Release/*.node",
          "build/Release/spawn-helper",
          "build/Release/*.dll",
          "build/Release/*.exe",
          "build/Release/conpty/**/*",
          "!lib/*.test.js",
          "!**/*.pdb",
          "!**/*.lib"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "identity": null,
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis",
      "artifactName": "NeuxBot-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "en-US",
      "zh-CN",
      "zh_CN"
    ]
  },
  "description": "NeuxBot 本地伙伴工作台",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JieWaZi/NeuxBot.git"
  }
}
