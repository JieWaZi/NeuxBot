+// propagateStatusErrors 按反向依赖传播至固定点，递归环中的半成品不会成为最终缓存。
+func (scanner *StatusErrScanner) propagateStatusErrors() {
+	queue := scanner.pending
+	scanner.pending = nil
+	queued := make(map[*types.Func]bool, len(queue))
+	for _, fn := range queue {
+		queued[fn] = true
+	}
+	for head := 0; head < len(queue); head++ {
+		callee := queue[head]
+		queued[callee] = false
+		if len(scanner.errorsUsed[callee]) == 0 {
+			continue
+		}
+		for caller := range scanner.callers[callee] {
+			before := len(scanner.errorsUsed[caller])
+			scanner.appendStateErrs(caller, scanner.errorsUsed[callee]...)
+			if len(scanner.errorsUsed[caller]) > before && !queued[caller] {
+				queue = append(queue, caller)
+				queued[caller] = true
+			}
+		}
+	}
 }
 
