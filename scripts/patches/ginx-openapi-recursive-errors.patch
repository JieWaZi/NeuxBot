+package openapi
+
+import (
+	"go/token"
+	"go/types"
+	"reflect"
+	"testing"
+
+	"github.com/go-courier/packagesx"
+)
+
+func TestStatusErrorsRecursiveClosure(t *testing.T) {
+	pkg, err := packagesx.Load("./testdata/status_err_cycle")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, order := range [][]string{{"A", "B", "C", "Outer"}, {"C", "B", "A", "Outer"}, {"Outer", "B", "C", "A"}} {
+		scanner := NewStatusErrScanner(pkg)
+		for _, name := range order {
+			fn := pkg.Types.Scope().Lookup(name).(*types.Func)
+			got := []string{}
+			for _, status := range scanner.StatusErrorsInFunc(fn) {
+				got = append(got, status.K)
+			}
+			if !reflect.DeepEqual(got, []string{"CycleA", "CycleB", "CycleC"}) {
+				t.Fatalf("order %v function %s lost recursive errors: %v", order, name, got)
+			}
+		}
+		for _, name := range []string{"EmptyA", "EmptyB"} {
+			fn := pkg.Types.Scope().Lookup(name).(*types.Func)
+			if got := scanner.StatusErrorsInFunc(fn); len(got) != 0 {
+				t.Fatalf("empty cycle produced errors: %v", got)
+			}
+		}
+	}
+	for _, order := range [][]string{{"PairA", "PairB"}, {"PairB", "PairA"}} {
+		scanner := NewStatusErrScanner(pkg)
+		for _, name := range order {
+			fn := pkg.Types.Scope().Lookup(name).(*types.Func)
+			got := []string{}
+			for _, status := range scanner.StatusErrorsInFunc(fn) {
+				got = append(got, status.K)
+			}
+			if !reflect.DeepEqual(got, []string{"PairA", "PairB"}) {
+				t.Fatalf("pair order %v function %s: %v", order, name, got)
+			}
+		}
+	}
+	scanner := NewStatusErrScanner(pkg)
+	func() {
+		defer func() {
+			if recover() == nil {
+				t.Fatal("unloaded package must exercise the scan panic boundary")
+			}
+		}()
+		scanner.StatusErrorsInFunc(types.NewFunc(token.NoPos, types.NewPackage("unloaded", "unloaded"), "Missing", nil))
+	}()
+	for _, name := range []string{"A", "B", "C"} {
+		fn := pkg.Types.Scope().Lookup(name).(*types.Func)
+		got := []string{}
+		for _, status := range scanner.StatusErrorsInFunc(fn) {
+			got = append(got, status.K)
+		}
+		if !reflect.DeepEqual(got, []string{"CycleA", "CycleB", "CycleC"}) {
+			t.Fatalf("recovered scan poisoned function %s: %v", name, got)
+		}
+	}
+	got := []string{}
+	for _, status := range scanner.StatusErrorsInFunc(pkg.Types.Scope().Lookup("EqualCode").(*types.Func)) {
+		got = append(got, status.K)
+	}
+	if !reflect.DeepEqual(got, []string{"EqualA", "EqualZ"}) {
+		t.Fatalf("equal-code order is unstable: %v", got)
+	}
+}
