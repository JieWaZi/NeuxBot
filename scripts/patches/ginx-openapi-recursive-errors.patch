+package cycle
+
+import _ "github.com/shrewx/ginx/pkg/statuserror"
+
+// @err[CycleA][40000000001][cycle A]
+func A() { B() }
+
+// @err[CycleB][40300000001][cycle B]
+func B() { C() }
+
+// @err[CycleC][40400000001][cycle C]
+func C() { A() }
+
+func Outer() { B() }
+
+func EmptyA() { EmptyB() }
+func EmptyB() { EmptyA() }
+
+// @err[PairA][40000000001][pair A]
+func PairA() { PairB() }
+
+// @err[PairB][40300000001][pair B]
+func PairB() { PairA() }
+
+// @err[EqualZ][40000000001][equal Z]
+// @err[EqualA][40000000001][equal A]
+func EqualCode() {}
